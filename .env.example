# Optional. Prefer config.yaml for most settings.
# Copy to .env and fill in. Never commit .env.

# Netscape cookies exported from a browser that can open Douyin.
# DYLIVE_COOKIES=cookies.txt

# If you are outside mainland China, a proxy that can open live.douyin.com.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Override config file path
# DYLIVE_CONFIG=config.yaml
