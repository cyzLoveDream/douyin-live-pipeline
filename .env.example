# Optional. Prefer config.yaml for most settings.
# Copy to .env and fill in. Never commit .env.

# Netscape cookies exported from a browser that can open Douyin.
# DYLIVE_COOKIES=cookies.txt

# If you are outside mainland China, a proxy that can open live.douyin.com.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Override config file path
# DYLIVE_CONFIG=config.yaml

# --- 大模型 DeepSeek（导演决策 + 文案生成）---
DYLIVE_LLM_API_KEY=sk-xxx
# DYLIVE_LLM_BASE_URL=https://api.deepseek.com
# DYLIVE_LLM_MODEL=deepseek-v4-pro
# DYLIVE_LLM_FAST_MODEL=deepseek-v4-flash

# --- 可选多模态：豆包 Vision（火山方舟，抽帧选封面）---
# DYLIVE_VISION_API_KEY=xxx
# DYLIVE_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DYLIVE_VISION_MODEL=doubao-1.5-vision-pro

